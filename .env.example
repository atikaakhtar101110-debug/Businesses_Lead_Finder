# Anthropic (used by all agents for reasoning / extraction / scoring)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Web search provider (SerpAPI: https://serpapi.com/)
SERPAPI_API_KEY=your_serpapi_api_key

# Geoapify Places API - free tier, no credit card required
# Sign up at https://myprojects.geoapify.com/ and grab your key
GEOAPIFY_API_KEY=your_geoapify_api_key

# Optional: Hunter.io for domain-based email discovery (https://hunter.io/)
HUNTER_API_KEY=your_hunter_io_api_key_optional

# App settings
CLAUDE_MODEL=claude-sonnet-4-6
MAX_LEADS=25
REQUEST_TIMEOUT=15
LOG_LEVEL=INFO
OUTPUT_DIR=output
